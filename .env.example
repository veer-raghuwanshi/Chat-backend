# Application Port
PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=chat_backend
PG_USER=postgres
PG_PASSWORD=postgrespassword
# Or full connection string (optional):
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/chat_backend

# Firebase Configuration
# Option A: Path to service account JSON file
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option B: Individual Service Account Credentials (environment-based)
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option C: Firebase Firestore Emulator (for offline local development)
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_PROJECT_ID=chat-backend-emulator

