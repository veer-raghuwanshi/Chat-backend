{
  "name": "chat-backend",
  "version": "1.0.0",
  "description": "Chat backend with PostgreSQL & Firebase Firestore",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
